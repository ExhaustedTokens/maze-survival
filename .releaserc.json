{
  "branches": ["main", { "name": "staging", "prerelease": "rc" }],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "release/*.zip", "label": "Compiled scripts (dist)" }]
      }
    ]
  ]
}
